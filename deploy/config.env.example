# Copy this file to deploy/config.env and edit values.

PROJECT_NAME=projectx
REPO_URL=https://github.com/Manlikenonso1k/project-x.git

# Source mode for app code:
# - auto: use LOCAL_SOURCE_DIR (or current repo) if available, else use REPO_URL
# - local: require a local source path and never clone from REPO_URL
# - remote: always clone/pull from REPO_URL
USE_LOCAL_SOURCE=auto
# Example: /home/ubuntu/project-x
LOCAL_SOURCE_DIR=

PROJECT_DIR=/var/www/projectx
APP_DIR=/var/www/projectx/app
SERVICE_FILE=/etc/systemd/system/projectx.service
START_SCRIPT=/home/ubuntu/start_projectx.sh
TOR_DIR=/var/lib/tor/projectx_hidden_service
APP_PORT=8001
RUN_USER=ubuntu

# Optional Telegram notification (leave blank to disable).
BOT_TOKEN=
CHAT_ID=
